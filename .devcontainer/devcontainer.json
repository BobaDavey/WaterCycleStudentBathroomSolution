{
  "name": "WaterCycle",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "containerEnv": {
    "LOCAL_DATABASE": "true",
    "DEMO_MODE": "true",
    "WATERCYCLE_ENVIRONMENT": "development"
  },
  "postCreateCommand": "npm install && npm run dev:setup",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "WaterCycle",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  }
}
