# Credentials and local-only classroom records must never be uploaded.
.env
.env.*
.local/
.git/

# Dependencies, builds, caches and test artifacts are recreated remotely.
node_modules/
.next/
.next-e2e/
.npm/
.npm-cache/
playwright-report/
test-results/
*.log

# Private logical database backups must stay outside Git/deployments.
backups/
.backups/
*.dump
*.backup
*.sql.gz
*.sql.zst
