{
  "name": "watercycle",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "admin:bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/bootstrap-admin.ts",
    "db:status": "node --env-file-if-exists=.env.local --import tsx scripts/database-status.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup-database.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "dev:setup": "node scripts/setup-codespaces.mjs",
    "dev:admin": "tsx scripts/bootstrap-development-admin.ts",
    "dev:doctor": "tsx scripts/development-doctor.ts",
    "test:fresh": "node scripts/test-fresh-development.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@next/env": "16.4.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
