# Managed PostgreSQL connection string for Vercel / shared deployments.
# Preserve the provider's TLS parameters (typically ?sslmode=require).
DATABASE_URL=

# Administrator initialization ONLY: supply a private password through a
# Codespaces secret, Vercel environment setting, or ignored .env.local.
# Username is fixed: david anze zhang, written as davidanzezhang.
# Never commit an actual password here. Remove this secret after provisioning.
ADMIN_INITIAL_PASSWORD=

# Local sample accounts only; do not enable on a public Vercel deployment.
# Codespaces enables these automatically in the private development container.
# LOCAL_DATABASE=true
# DEMO_MODE=true
