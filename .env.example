# Vercel: use a managed PostgreSQL connection string (for example, Neon).
# Keep the provider's TLS parameters, typically ?sslmode=require.
DATABASE_URL=

# Required ONLY when creating the first teacher. Generate a long random key.
# Set in Vercel environment settings; enter it on the first-teacher setup form.
# Remove this variable after creating the teacher account.
TEACHER_SETUP_KEY=

# Local demo only. Never set LOCAL_DATABASE or DEMO_MODE on Vercel.
# LOCAL_DATABASE=true
# DEMO_MODE=true
