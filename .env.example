# Managed runtime settings: scope separately in Vercel Production and Preview.
# Keep real connection strings and passwords private. Never use NEXT_PUBLIC_ names.
DATABASE_URL=
# Required for every managed connection; must match VERCEL_ENV on Vercel.
WATERCYCLE_ENVIRONMENT=
# A stable UUID for this database, generated once. Preview must use a different ID.
WATERCYCLE_DATABASE_ID=

# Trusted operator terminal ONLY. Do not add migration credentials to Vercel.
# Use the direct owner connection for the SAME database as its runtime connection.
MIGRATION_DATABASE_URL=
# Explicit one-time credential setup only; ignored by managed application startup.
ADMIN_INITIAL_PASSWORD=

# Local development only. Never enable these on Vercel.
# LOCAL_DATABASE=true
# DEMO_MODE=true
# LOCAL_DATABASE_PATH=.local/data

# Optional isolated-local admin testing only; prefer the hidden npm run dev:admin prompt.
# DEV_ADMIN_INITIAL_PASSWORD=
